{
  "_comment": "Merged into ~/.claude/settings.json by install.ps1. Each top-level key under 'settings' is set in settings.json; each event under 'hooks' REPLACES that event in settings.json; keys and events not listed are left alone. Placeholders: {{PYTHON}} = python.exe, {{CLAUDE_DIR}} = ~/.claude (forward slashes).",
  "settings": {
    "cleanupPeriodDays": 36500
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -Command \"(New-Object System.Media.SoundPlayer \\\"$env:windir\\Media\\Windows Proximity Notification.wav\\\").PlaySync()\"",
            "timeout": 10,
            "statusMessage": "Notification sound"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["{{CLAUDE_DIR}}/skills/hooks/session-colocate/session_colocate.py"],
            "timeout": 30,
            "statusMessage": "Co-locating session temp data"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File {{CLAUDE_DIR}}/hooks/brainstorm-session-start.ps1",
            "timeout": 10,
            "statusMessage": "Offering to brainstorm"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_DIR}}/skills/hooks/tldr-gate/tldr_switch.py\"",
            "timeout": 10,
            "statusMessage": "TL;DR gate switch"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_DIR}}/skills/hooks/tldr-gate/tldr_gate.py\"",
            "timeout": 10,
            "statusMessage": "TL;DR gate"
          }
        ]
      }
    ]
  }
}
